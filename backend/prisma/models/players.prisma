model Players {
    id              Int            @id @default(autoincrement())
    userId          Int
    user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    mesaId          Int
    mesa            Mesa           @relation(fields: [mesaId], references: [id], onDelete: Cascade)
    role            PlayerRole     @default(PLAYER)
    userCharacterId Int?
    userCharacter   UserCharacter? @relation(fields: [userCharacterId], references: [id], onDelete: SetNull)
    joinedAt        DateTime       @default(now())
    updatedAt       DateTime       @updatedAt

    @@unique([userId, mesaId])
    @@map("mesa_players")
}

enum PlayerRole {
    MASTER
    PLAYER
    SPECTATOR
}
