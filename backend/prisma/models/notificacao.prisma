model Notificacao {
    id            Int             @id @default(autoincrement())
    destinoId     Int
    destino       User            @relation("NotificacoesRecebidas", fields: [destinoId], references: [id], onDelete: Cascade)
    remetenteId   Int?
    remetente     User?           @relation("NotificacoesEnviadas", fields: [remetenteId], references: [id], onDelete: SetNull)
    tipo          TipoNotificacao
    message       String
    solicitacaoId Int?
    solicitacao   Solicitacao?    @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
    mesaId        Int?
    mesa          Mesa?           @relation(fields: [mesaId], references: [id], onDelete: Cascade)
    postId        Int?
    post          Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    readAt        DateTime?

    @@index([destinoId])
    @@index([destinoId, readAt])
    @@index([solicitacaoId])
    @@index([mesaId])
    @@index([postId])
    @@map("notificacoes")
}

enum TipoNotificacao {
    SOLICITACAO_RECEBIDA
    SOLICITACAO_ACEITA
    SOLICITACAO_RECUSADA
    NOVO_POST_MESA
    POST_PRIVADO
    JOGADOR_REMOVIDO_MESA
    MESA_EXCLUIDA
    LEMBRETE_JOGADA
}
