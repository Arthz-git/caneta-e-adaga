model User {
    id                    Int             @id @default(autoincrement())
    name                  String
    email                 String          @unique
    password              String
    role                  Int             @default(200)
    createdAt             DateTime        @default(now())
    updatedAt             DateTime        @updatedAt
    characters            UserCharacter[]
    posts                 Post[]
    refreshTokens         RefreshToken[]
    mesasCreated          Mesa[]
    players               Players[]
    solicitacoesEnviadas  Solicitacao[]   @relation("SolicitacoesEnviadas")
    solicitacoesRecebidas Solicitacao[]   @relation("SolicitacoesRecebidas")
    notificacoesRecebidas Notificacao[]   @relation("NotificacoesRecebidas")
    notificacoesEnviadas  Notificacao[]   @relation("NotificacoesEnviadas")

    @@map("users")
}
