model UserCharacter {
    id          Int        @id @default(autoincrement())
    userId      Int
    user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    description String     @db.Text
    lore        String     @db.Text
    imageUrl    String?
    gameSystem  GameSystem
    sheet       Json?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    players     Players[]
    posts       Post[]

    @@index([userId])
    @@map("characters")
}
