model Post {
    id          Int           @id @default(autoincrement())
    userId      Int
    author      User          @relation(fields: [userId], references: [id])
    mesaId      Int
    mesa        Mesa          @relation(fields: [mesaId], references: [id], onDelete: Cascade)
    text        String        @db.Text
    type        PostType      @default(NARRATOR)
    characterId Int?
    character   UserCharacter? @relation(fields: [characterId], references: [id])
    npcName     String?
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    visiblePlayers PostVisiblePlayer[]
    notificacoes   Notificacao[]

    @@index([mesaId])
    @@map("posts")
}

model PostVisiblePlayer {
    id       Int     @id @default(autoincrement())
    postId   Int
    post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
    playerId Int
    player   Players @relation(fields: [playerId], references: [id], onDelete: Cascade)

    @@unique([postId, playerId])
    @@map("post_visible_players")
}

enum PostType {
    CHARACTER
    NARRATOR
    NPC
    SYSTEM
    OOC
}
